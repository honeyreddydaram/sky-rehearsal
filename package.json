{
  "name": "sky-rehearsal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ground-based VFR circuit rehearsal with React, TypeScript and Cesium",
  "scripts": {
    "test": "node core.test.mjs && node tests/circuit.test.mjs && tsx tests/html-structure.test.tsx",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/copy-cesium.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.9.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "cesium": "1.121.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "overrides": {
    "@zip.js/zip.js": "2.7.53",
    "@cesium/engine": "11.0.0",
    "@cesium/widgets": "8.0.0"
  }
}
