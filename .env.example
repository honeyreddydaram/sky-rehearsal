# Backend environment. Use a real Google project and workload identity in production.
FIREBASE_PROJECT_ID=
APP_ENV=production
# Only local demos should set APP_ENV=development and these emulator variables:
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Optional Milestone 7 Gemini / Vertex AI, server only. Never prefix with VITE_.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Choose a Gemini model available in your project's selected location.
GEMINI_MODEL=
